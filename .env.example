# Copiar este archivo como ".env" y completar con los datos de cada computadora.
# El archivo .env NO se sube a GitHub (tiene contraseñas). Nunca pegar la contraseña en un chat.

# Puerto donde escucha el sitio (http://localhost:3000)
PUERTO=3000

# Base de datos PostgreSQL en Supabase. Cómo conseguir esta dirección:
#   supabase.com -> tu proyecto -> botón "Connect" -> pestaña "Connection String"
#   -> elegir "Session pooler" -> copiar la dirección y reemplazar [YOUR-PASSWORD]
#   por la contraseña de la base (la que se eligió al crear el proyecto).
# Queda parecida a esta:
#   postgresql://postgres.abcdefghijk:TuClave@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Si la contraseña tiene símbolos como @ # / ? cambiala en Supabase por una de letras y números.
DATABASE_URL=

# Opcional: para verificar que la conexión es realmente con Supabase, descargar el certificado
# (Supabase -> Project Settings -> Database -> SSL Configuration -> Download certificate)
# y poner acá la ruta del archivo, por ejemplo:  DB_SSL_CERTIFICADO=certificados/prod-ca-2021.crt
DB_SSL_CERTIFICADO=

# Dominio del Gmail escolar permitido para registrarse (sin @). A CONFIRMAR.
# Se pueden poner varios separados por coma. Si queda vacío, se acepta cualquier email
# (solo para probar: antes de la entrega hay que completarlo).
EMAIL_DOMINIO=

# Clave secreta para firmar las sesiones. En el servidor de la escuela poner una
# frase larga y distinta (por ejemplo, 40 letras y números al azar).
SESION_SECRETO=cambiar-esta-clave-en-el-servidor

# Tamaño máximo del ZIP de cada proyecto, en megabytes
ZIP_MAX_MB=250
