# Copiar este archivo como ".env" y completar con los datos de cada computadora.
# El archivo .env NO se sube a GitHub (tiene contraseñas).

# Puerto donde escucha el sitio (http://localhost:3000)
PUERTO=3000

# Base de datos MySQL / MariaDB (en XAMPP: usuario root sin contraseña)
DB_HOST=localhost
DB_PUERTO=3306
DB_USUARIO=root
DB_CLAVE=
# (si lo cambiás, cambiá también el nombre en database/schema.sql y seed.sql)
DB_NOMBRE=fppt

# Dominio del Gmail escolar permitido para registrarse (sin @). A CONFIRMAR.
# Se pueden poner varios separados por coma. Si queda vacío, se acepta cualquier email
# (solo para probar: antes de la entrega hay que completarlo).
EMAIL_DOMINIO=

# Clave secreta para firmar las sesiones. En el servidor de la escuela poner una
# frase larga y distinta (por ejemplo, 40 letras y números al azar).
SESION_SECRETO=cambiar-esta-clave-en-el-servidor

# Tamaño máximo del ZIP de cada proyecto, en megabytes
ZIP_MAX_MB=250
