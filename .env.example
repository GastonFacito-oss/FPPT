# Copiar este archivo como ".env" y completar con los datos de cada computadora.
# El archivo .env NO se sube a GitHub (tiene contraseñas).
# Para el servidor de la escuela, ver docs/instalacion-servidor.md

# Modo: vacío = desarrollo (con datos y ayudas de prueba). production = servidor de la escuela.
NODE_ENV=

# Puerto donde escucha el sitio (http://localhost:3000)
PUERTO=3000
# Desde dónde se aceptan visitas: vacío = toda la red. En el servidor, detrás del HTTPS: 127.0.0.1
HOST=

# Base de datos MySQL / MariaDB (en XAMPP para probar: usuario root sin contraseña)
DB_HOST=localhost
DB_PUERTO=3306
DB_USUARIO=root
DB_CLAVE=
# (si lo cambiás, cambiá también el nombre en database/schema.sql y seed.sql)
DB_NOMBRE=fppt

# Dominio del Gmail escolar permitido para registrarse (sin @). A CONFIRMAR.
# Se pueden poner varios separados por coma. Si queda vacío, se acepta cualquier email
# (solo para probar: antes de publicar el sitio hay que completarlo).
EMAIL_DOMINIO=

# Clave secreta para firmar las sesiones. En el servidor: generar una con
#   npm run generar-secreto
# y pegarla acá (mínimo 32 caracteres). En producción el sitio no arranca con la de ejemplo.
SESION_SECRETO=cambiar-esta-clave-en-el-servidor

# Cuántos servidores intermedios hay delante del sitio poniendo el HTTPS
# (Apache o nginx de la escuela). 0 = ninguno. Con Apache/nginx delante: 1
PROXY_CONFIABLE=0

# Tamaño máximo del ZIP de cada proyecto, en megabytes
ZIP_MAX_MB=250
